# Copy to beta.env next to docker-compose.beta.yml and fill in.
# beta.env holds your SECRET: keep it out of git and readable only by you
# (chmod 600 beta.env).

# The exact SECRET your stable Floppy uses.
SECRET=

# The address the beta server is reached at (Cloudflare tunnel hostname).
BETA_URL=https://beta.example.com

# Host port the beta server listens on (stable usually uses 8000).
BETA_PORT=8001

# Where beta keeps its own data (db/ and backups/ are created inside).
BETA_DATA_DIR=./beta

TZ=Europe/Rome

# Name of your running stable container (docker ps shows it).
STABLE_CONTAINER=floppy

# Written by beta-update.sh: the image tag beta runs.
FLOPPY_BETA_TAG=beta
